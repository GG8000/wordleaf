# From Supabase dashboard -> Project Settings -> API (or `npx supabase status` locally)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare Turnstile site key (dash.cloudflare.com -> Turnstile). This is Cloudflare's test key:
# it always passes and matches the test secret in supabase/config.toml. Leave empty to hide the captcha.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Web Push for duels (optional). Generate a key pair with `npx web-push generate-vapid-keys`;
# the public key goes here, both keys go into the send-push Edge Function secrets (see README).
VITE_VAPID_PUBLIC_KEY=
